{
  "name": "cuelab",
  "productName": "CueLab",
  "version": "1.0.0",
  "description": "Learn to DJ on your Pioneer DJ DDJ-FLX4: step-by-step lessons, practice studio, free practice tracks and study mode.",
  "main": "main.js",
  "author": "julian-ymo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.julianymo.cuelab",
    "productName": "CueLab",
    "copyright": "CueLab",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CueLab",
      "artifactName": "CueLab-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "CueLab-Portable-${version}.exe"
    }
  }
}
